# Copy this file to .env and fill in your private credentials.
ZOTERO_API_KEY=your-zotero-api-key
ZOTERO_USER_ID=your-zotero-user-id
ZOTERO_API_BASE=https://api.zotero.org
API_VERSION=3
RATE_LIMIT_DELAY=2.0

# Deployment profile: "mac" (default; local Zotero storage + local/AppleScript
# DEVONthink) or "server" (headless Linux; DEVONthink reached over the network).
DEVONZOT_PROFILE=mac

# Runtime paths. All default to the repo root; override for non-standard layouts.
#   DEVONZOT_PATH      — root for service_state.json, service.log, service.pid, indexes
#   DEVONZOT_LOG_FILE  — override just the log file location
#   ZOTERO_STORAGE_PATH / ZOTFILE_IMPORT_PATH / DEVONTHINK_INBOX_PATH — macOS-only
#     locations; never dereferenced on the "server" profile.
# DEVONZOT_PATH=/home/youruser/DEVONzot
# DEVONZOT_LOG_FILE=/home/youruser/DEVONzot/service.log
# ZOTERO_STORAGE_PATH=/Users/travisross/Zotero/storage

# DEVONthink control backend
# DEVONZOT_USE_MCP=true drives DEVONthink via its built-in MCP server (token auth,
# no AppleScript/TCC). Requires DEVONthink > Settings > AI > MCP enabled, with the
# bearer token below. Leave false to use the legacy AppleScript path.
DEVONZOT_USE_MCP=false
DEVONTHINK_MCP_URL=http://localhost:8420
DEVONTHINK_MCP_TOKEN=your-devonthink-mcp-bearer-token

# Content-hash dedup gate (SHA-256 + DEVONthink native duplicate detection).
#   off    (default) — legacy name-search dedup only; byte-identical to before.
#   shadow — observe-only: logs DEDUP-OBSERVE "would adopt/would trash" lines but
#            mutates nothing and leaves migration behavior unchanged.
#   live   — adopt content duplicates + trash redundant imports + stamp contentsha256.
DEDUP_GATE_MODE=off

# WebSocket Streaming Configuration
WEBSOCKET_ENABLED=true              # Use Zotero Streaming API (event-driven instead of polling)
FALLBACK_POLL_INTERVAL=600          # Fallback poll interval in seconds if no stream events (default: 10 min)
FALLBACK_POLL_ENABLED=true          # Enable fallback polling (set false for stream-only mode)

# Zotero Translation Server (metadata extraction from URLs and identifiers)
# Uses same translators as the Zotero browser connector
# For self-hosted: docker run -d -p 1969:1969 zotero/translation-server
TRANSLATION_SERVER_URL=https://t0guvf0w17.execute-api.us-east-1.amazonaws.com/Prod
TRANSLATION_TIMEOUT=30

# Pipeline Configuration
# TMP_DIR defaults to <DEVONZOT_PATH>/tmp_extractions; override only if needed.
# TMP_DIR=/path/to/tmp_extractions
EXTRACTION_TIMEOUT=120
DEBUG_MODE=false

# Article Extraction Fallback Configuration
# Three-tier cascading fallback system for maximum extraction success rate
ENABLE_RSS_FALLBACK=true         # Tier 1: RSS/Atom feeds (Substack, Medium, WordPress)
ENABLE_PLAYWRIGHT=false          # Tier 2: Browser automation (requires: pip install playwright && playwright install chromium)
ENABLE_WAYBACK=true              # Tier 3: Internet Archive snapshots (paywalled/deleted content)
PLAYWRIGHT_TIMEOUT=30000         # Playwright page load timeout in milliseconds
WAYBACK_TIMEOUT=15               # Wayback Machine API timeout in seconds
